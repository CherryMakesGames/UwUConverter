{
  "manifest_version": 3,
  "name": "UwUConverter Browser Integration",
  "version": "0.11.0",
  "description": "Right-click web images and download them converted by the installed UwUConverter app.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uwuconverter@pinksakurastudios.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
